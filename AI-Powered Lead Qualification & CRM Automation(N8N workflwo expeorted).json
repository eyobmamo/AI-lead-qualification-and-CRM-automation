        "responses": {
          "values": [
            {
              "content": "=You are a professional B2B sales email assistant.\n\nCreate a personalized email draft for the sales representative based on the lead information below.\n\nLead:\n\nEmail: {{ $json.lead.email }}\n\n\nQualification:\nScore: {{ $('Webhook').item.json.body.score }}\nCategory: {{ $('Webhook').item.json.body.category }}\nSummary: {{ $('Webhook').item.json.body.summary }}\nRecommended Action: {{ $('Webhook').item.json.body.recommended_action }}\n\nYour task:\n- Write a professional and natural B2B follow-up email.\n- Personalize it using the lead's message.\n- Do not invent information about the company.\n- Keep it concise.\n- Follow the recommended action.\n- This is a DRAFT for a salesperson to review.\n- Do not send the email.\n\nReturn ONLY valid JSON in exactly this format:\n\n{\n  \"subject\": \"Email subject\",\n  \"body\": \"Email body\"\n}"
            }
          ]
        },
